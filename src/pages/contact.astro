---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact"
  description="Get in touch with the tech-ologist. Instagram is the best place to catch me."
  fullWidth={true}
>

<style>
  .hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    color: #fff;
    padding: 5rem 2rem 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(199,125,255,0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(77,150,255,0.06) 0%, transparent 40%);
    pointer-events: none;
  }
  .hero-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcb77, #4d96ff, #c77dff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .hero-dek {
    font-size: 1.05rem;
    color: #aaa;
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .page-wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .section {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 2.5rem 3rem;
    margin-bottom: 2rem;
  }

  .section-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcb77, #4d96ff, #c77dff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.6rem;
  }

  .section h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1a1a2e;
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .section p {
    color: #444;
    margin-bottom: 1rem;
    font-size: 0.97rem;
  }
  .section p:last-child { margin-bottom: 0; }

  .contact-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #1a1a2e;
    color: #fff;
    text-decoration: none;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  .contact-link:hover { background: #2a2a4e; }
  .contact-link.secondary {
    background: transparent;
    color: #1a1a2e;
    border: 1.5px solid #e0e0e0;
  }
  .contact-link.secondary:hover { border-color: #a855f7; color: #a855f7; }
  .contact-link svg { width: 16px; height: 16px; flex-shrink: 0; }

  @media (max-width: 640px) {
    .hero { padding: 3.5rem 1.5rem 3rem; }
    .section { padding: 1.75rem 1.5rem; }
    .page-wrap { padding: 2rem 1rem 4rem; }
  }
</style>

<section class="hero">
  <div class="hero-label">Make Contact</div>
  <h1>Find the tech-ologist</h1>
  <p class="hero-dek">If you've found something useful, spotted an error, or you're working on something weird and want to compare notes.</p>
</section>

<main class="page-wrap">

  <div class="section">
    <div class="section-label">Get in touch</div>
    <h2>Instagram is the best place</h2>
    <p>
      Instagram is where I post builds in progress, wiring disasters, and the occasional thing that actually works. It's also the best place to send a message if you want to talk shop.
    </p>
    <div class="contact-row">
      <a class="contact-link" href="https://instagram.com/electroniczoology" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
        </svg>
        @electroniczoology
      </a>
      <a class="contact-link secondary" href="https://ig.me/m/electroniczoology" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        Send a message
      </a>
    </div>
  </div>

</main>

</Base>
