<GuideLayout
  title="INA219 Battery Charger Monitor with OLED - Never Charge Blind"
  description="Build a real-time battery charger monitor with an INA219 current sensor, a TP4056 charger module, and a 4-pin SSD1306 OLED. Watch the full CC/CV charge curve unfold and spot misbehaving chargers before they cook a cell."
  toc={[
    {href: '#what-youll-learn', label: 'What You Will Learn'},
    {href: '#hardware', label: 'Hardware'},
    {href: '#wiring', label: 'Wiring'},
    {href: '#sketch', label: 'The Sketch'},
    {href: '#what-youll-see', label: 'What You Will See'},
